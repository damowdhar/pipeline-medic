# Copy to .env and adjust. Every value has a working default in app/config.py.

GOOGLE_CLOUD_PROJECT=dm-agentic-hackathon-2026

# Must be "global" -- Gemini 3.x is not served from regional Vertex endpoints.
GOOGLE_CLOUD_LOCATION=global
MEDIC_MODEL=gemini-3.7-flash

# Firestore database id. Not "(default)".
FIRESTORE_DATABASE=hackathon

MEDIC_BQ_DATASET=medic_demo
MEDIC_REGION=us-central1
MEDIC_PUBSUB_TOPIC=pipeline-failures

# Off by default: when false the agent writes a proposed patch to Firestore
# instead of opening a pull request.
MEDIC_ALLOW_PRS=false
